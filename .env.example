# ===========================================
# LLM API 配置
# ===========================================

# API Key（必需）
# OpenAI: 从 https://platform.openai.com/api-keys 获取
# OpenRouter: 从 https://openrouter.ai/keys 获取
LLM_API_KEY=your_api_key_here

# 或者使用 OPENAI_API_KEY（向后兼容）
# OPENAI_API_KEY=your_openai_api_key_here

# API Base URL（可选）
# 默认: https://api.openai.com/v1
# OpenRouter: https://openrouter.ai/api/v1
# 其他兼容服务的 URL
# LLM_BASE_URL=https://openrouter.ai/api/v1

# 模型名称（可选）
# 默认: gpt-4o-mini
# OpenRouter 示例: anthropic/claude-3.5-sonnet, openai/gpt-4-turbo
# LLM_MODEL=gpt-4o-mini

# 温度参数（可选，0-2）
# 默认: 0.7
# 较低的值使输出更确定，较高的值使输出更随机
# LLM_TEMPERATURE=0.7

# 最大 Tokens（可选）
# 默认: 2000
# LLM_MAX_TOKENS=2000

# 自定义请求头（可选，JSON 格式）
# 用于某些服务需要额外的请求头
# 示例: {"HTTP-Referer": "https://your-site.com", "X-Title": "Your App"}
# LLM_DEFAULT_HEADERS={}

# ===========================================
# 常用配置示例
# ===========================================

# 示例 1: 使用 OpenAI (默认)
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

# 示例 2: 使用 OpenRouter
# LLM_API_KEY=sk-or-v1-...
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=anthropic/claude-3.5-sonnet
# LLM_DEFAULT_HEADERS={"HTTP-Referer": "https://your-site.com"}

# 示例 3: 使用其他兼容 OpenAI 的服务
# LLM_API_KEY=your_key
# LLM_BASE_URL=https://your-service.com/v1
# LLM_MODEL=your-model-name
